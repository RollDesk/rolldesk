# Copy this file to .env and adjust the values.
# On the target server, keep .env next to docker-compose.yml.

# ---- Access control ----
# Comma- or space-separated list of allowed IPs / CIDR subnets (IPv4/IPv6).
# Example: 203.0.113.4, 198.51.100.0/24, 10.8.0.0/24
# Empty = access from any IP (NOT recommended in production).
ALLOWED_IPS=

# ---- HTTP port exposed by the frontend (nginx) ----
HTTP_PORT=8080

# ---- Public application URL ----
# Where RollDesk is reachable for end users, e.g. https://rolldesk.example.com
# When set, outgoing notifications (webhooks / e-mail) include a link back to
# the app. Leave empty to omit links.
# REQUIRED for single sign-on (SSO): it is used to build the OIDC redirect URI
# (<APP_BASE_URL>/api/auth/sso/callback) that you register in the identity provider.
APP_BASE_URL=

# ---- Time zone ----
# IANA zone for the timestamps the backend writes on deployment timelines and in
# the change history (e.g. Europe/Warsaw, UTC). The container image has no zone
# of its own, so leaving this unset means those entries are stamped in UTC while
# the ones the browser writes use the viewer's local time — on the same timeline.
# Defaults to Europe/Warsaw in the compose files.
APP_TIMEZONE=Europe/Warsaw

# ---- Notification language ----
# Language outgoing notifications (e-mail, Slack, Teams, webhooks) are written
# in: 'pl' or 'en'. A notification is composed in the browser of whoever
# triggered the event, so leaving this empty means it inherits *that person's* UI
# language — and the UI defaults to English, so the same client could be told
# about one deployment in English and the next in Polish. The recipients are a
# fixed audience per instance, so set the language of the instance here.
# Anything other than pl/en is ignored with a warning.
NOTIFY_LANG=pl

# ---- PostgreSQL ----
POSTGRES_USER=rolldesk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rolldesk

# ---- Authentication ----
# Secret used to sign session tokens (JWT). REQUIRED in production — the backend
# refuses to start without it. Generate a strong value, e.g.:
#   openssl rand -hex 32
# In development it may be left empty (an ephemeral secret is generated, so
# sessions reset whenever the backend restarts).
JWT_SECRET=

# ---- Single sign-on (SSO) ----
# Per-domain OIDC providers (Azure/Entra ID, Google, generic) are configured at
# runtime by an admin in the app; only this encryption key lives in the env.
# It protects the stored IdP client secrets at rest (AES-256-GCM). If empty, it
# is derived from JWT_SECRET; set a dedicated random value in production, e.g.:
#   openssl rand -hex 32
# SSO also requires APP_BASE_URL (see above).
SSO_ENC_KEY=

# ---- Virus scanning (ClamAV, runs as a separate container) ----
# Uploaded attachments are streamed to clamd before being stored. The compose
# files default CLAMAV_HOST to the bundled "clamav" service; leave these unless
# you point at an external scanner. Set CLAMAV_HOST empty to disable scanning.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# reject = block uploads when the scanner is unavailable (fail closed);
# allow  = accept unscanned uploads when the scanner is down (fail open).
CLAMAV_FAIL_MODE=reject

# ---- Microsoft Teams via Microsoft Graph (optional) ----
# When set, deployment notifications are posted to a Teams channel and grouped
# per deployment (one root message per deployment id, further events posted as
# replies in that thread). Register an app in Entra ID and grant it Graph
# permissions to post channel messages, then fill these in. Leave empty to use
# the per-client Incoming Webhooks instead.
# SECURITY: never commit real values — keep them only in your local/server .env.
# Feature flag — posting to Teams is OFF by default. Set GRAPH_ENABLED=1 only
# once the Entra app has the required Graph application permissions + admin
# consent (and the tenant allows app-only channel posting). While it's off,
# notifications use the webhooks below. Reading teams/channels for setup works
# regardless of this flag.
GRAPH_ENABLED=0
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Target team + channel. If you don't know the ids, configure the app above and
# call GET /api/teams/graph/teams and /api/teams/graph/channels?teamId=... (admin)
# to list them, or read them from Teams (dev mode shows channel ids).
TEAMS_TEAM_ID=
TEAMS_CHANNEL_ID=

# ---- SMTP (optional, for email notifications) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RollDesk <no-reply@rolldesk.local>

# ---- Update check (optional) ----
# The backend asks GitHub for the newest published release and caches the answer,
# so the browser never calls api.github.com itself. Everything here has a working
# default; leave it alone unless you run a fork or an air-gapped instance.
# A token is NOT required (the repository is public) — it only raises GitHub's
# anonymous rate limit of 60 requests/hour per IP.
GITHUB_TOKEN=
# Repository to check releases against.
VERSION_CHECK_REPO=RollDesk/rolldesk
# How long a successful answer is cached, in milliseconds (default 1 hour).
VERSION_CHECK_TTL_MS=3600000

# ---- Deployment from GitHub Container Registry (used by docker-compose.prod.yml) ----
# Image prefix the CI workflow publishes to; "-backend" and "-frontend" are
# appended to it. The default below is this project's own registry, so a server
# running docker-compose.prod.yml pulls the released images without any edit.
# Point it elsewhere only when running a fork's images.
# The images are private, so the server needs `docker login ghcr.io` once with a
# personal access token carrying `read:packages`.
IMAGE_PREFIX=ghcr.io/rolldesk/rolldesk
# Image tag to run on the server. `latest` follows main; pin a release (e.g.
# 0.18.0) to control exactly what a `docker compose pull` brings in.
TAG=latest
